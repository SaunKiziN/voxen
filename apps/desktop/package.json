{
  "name": "@sharkord/desktop",
  "private": true,
  "version": "0.0.23",
  "description": "VOXEN desktop smoke test",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev.ps1",
    "tauri": "tauri",
    "build": "tauri build",
    "check-types": "cargo check --manifest-path src-tauri/Cargo.toml",
    "lint": "cargo check --manifest-path src-tauri/Cargo.toml",
    "format": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
